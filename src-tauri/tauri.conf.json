{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dk-table",
  "version": "0.4.0",
  "identifier": "com.delikesance.dktable",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "dk-table", "width": 1200, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1Qjk1MzBDMTAwNzIzQTkKUldTcEl3Y1FERk81WmVVdnNpaHlWY3dvZWE0NHdJc2NMWGxRa2Z3bkN0aHYzNHhaSkRzeWk0TzMK",
      "endpoints": ["https://github.com/delikesance/dk-table/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
